# ==========================================
# AURALENS ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# 1. GOOGLE AI STUDIO / GEMINI API
# Lấy miễn phí tại: https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. GOOGLE CLOUD & CLOUD RUN SETTINGS
PORT=8080
NODE_ENV="development"
CORS_ORIGIN="*"

# 3. WEATHER & MAPS APIS (OPTIONAL)
WEATHER_API_KEY=""
WEATHER_API_DEFAULT_CITY="Ho Chi Minh City,VN"
GOOGLE_MAPS_API_KEY=""

# 4. FIREBASE CONFIGURATION (FOR CLIENT-SIDE)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="auralens-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="auralens-app"
VITE_FIREBASE_STORAGE_BUCKET="auralens-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
