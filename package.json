{
  "name": "auralens-monorepo",
  "version": "1.0.0",
  "description": "AuraLens — Personalized AI Stylist & Experience Map for Gen Z (Google Cloud & Gemini Multimodal)",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server test",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
